{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@sci-notebook/core": ["../core/src"],
      "@sci-notebook/renderer": ["../renderer/src"],
      "@sci-notebook/react": ["../react/src"]
    }
  },
  "include": ["src"]
}
