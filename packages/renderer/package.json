{
  "name": "@velo-sci/notebook-renderer",
  "version": "0.8.0",
  "description": "Markdown rendering pipeline for sci-notebook",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "test": "vitest run"
  },
  "dependencies": {
    "@velo-sci/notebook-core": "workspace:*",
    "dompurify": "^3.0.0",
    "markdown-it": "^14.0.0",
    "shiki": "^1.29.2"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.0",
    "@types/markdown-it": "^13.0.0",
    "tsup": "^8.0.0",
    "vitest": "^1.0.0"
  }
}
