{
  "name": "sci-notebook-monorepo",
  "private": true,
  "type": "module",
  "description": "Scientific Notebook Framework",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest",
    "docs:dev": "cd docs && pnpm start",
    "docs:build": "cd docs && pnpm build",
    "docs:preview": "cd docs && pnpm serve",
    "docs:api": "typedoc",
    "lint": "eslint packages/**/src/**/*.{ts,tsx}",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "dev": "pnpm -r dev",
    "release": "pnpm build && pnpm -r publish --access public"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "eslint": "^8.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
