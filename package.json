{
  "name": "sci-notebook-monorepo",
  "private": true,
  "type": "module",
  "description": "Scientific Notebook Framework",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest",
    "docs:dev": "vitepress dev docs",
    "examples:dev": "pnpm --filter @velo-sci/notebook-example dev",
    "docs:dev:simple": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc",
    "lint": "eslint packages/**/src/**/*.{ts,tsx}",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "dev": "pnpm -r dev",
    "release": "pnpm build && pnpm -r publish --access public"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "jsdom": "^25.0.1",
    "katex": "^0.16.28",
    "markdown-it-mathjax3": "^5.2.0",
    "mermaid": "^11.12.2",
    "prettier": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.0.0",
    "vue": "^3.5.28",
    "@velo-sci/notebook-core": "workspace:*",
    "@velo-sci/notebook-renderer": "workspace:*",
    "@velo-sci/notebook-react": "workspace:*",
    "@velo-sci/notebook-vue": "workspace:*",
    "@velo-sci/notebook-svelte": "workspace:*",
    "@velo-sci/notebook-vanilla": "workspace:*"
  },
  "packageManager": "pnpm@10.29.2"
}